# NVIDIA Nemotron / OpenAI-compatible API Configuration
# Get your API key from NVIDIA Build (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Default NVIDIA NIM OpenAI-compatible endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configurable model name (e.g., nvidia/nemotron-3.5-lightning-30b-a3b or nvidia/nemotron-4-340b-instruct)
# Verify available models in your NVIDIA account at https://build.nvidia.com
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Backend settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
