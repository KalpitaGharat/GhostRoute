# NVIDIA Nemotron / OpenAI-compatible API Configuration
# Obtain your API key from NVIDIA Build (https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Default NVIDIA NIM OpenAI-compatible endpoint
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Configurable model name (e.g., nvidia/nemotron-3.5-lightning-30b-a3b)
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Request timeout in seconds for Nemotron inference (default: 60.0)
NVIDIA_TIMEOUT=60.0

# Backend settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
